{% extends "base.njk" %}

{% set isEvent = true %}

{% block head %}
<style>
    .event-hero {
        background: linear-gradient(135deg, rgba(78, 205, 196, 0.1), rgba(44, 62, 80, 0.05));
        padding: 4rem 0 2rem;
        margin-top: 80px;
    }

    .event-content {
        padding: 4rem 0;
    }

    .event-main {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 3rem;
    }

    .event-body {
        background: white;
        border-radius: 20px;
        padding: 3rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    .event-sidebar {
        height: fit-content;
    }

    .event-info-card {
        background: white;
        border-radius: 20px;
        padding: 2rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        margin-bottom: 2rem;
    }

    .event-meta-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }

    .event-meta-item:last-child {
        border-bottom: none;
        margin-bottom: 0;
    }

    .event-meta-item svg {
        color: var(--primary-teal);
        flex-shrink: 0;
    }

    .event-meta-item .label {
        font-size: 0.875rem;
        color: var(--text-secondary);
        display: block;
    }

    .event-meta-item .value {
        font-weight: 600;
        color: var(--primary-navy);
        display: block;
    }

    .section-divider {
        margin: 3rem 0;
        padding: 2rem 0;
        border-top: 2px solid rgba(78, 205, 196, 0.2);
    }

    .agenda-section {
        background: rgba(107, 70, 193, 0.05);
        border-radius: 15px;
        padding: 2rem;
        margin: 2rem 0;
    }

    .agenda-section h3 {
        color: var(--primary-navy);
        margin-bottom: 1.5rem;
    }

    .agenda-item {
        display: flex;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }

    .agenda-item:last-child {
        border-bottom: none;
        margin-bottom: 0;
    }

    .agenda-time {
        font-weight: 600;
        color: var(--primary-teal);
        min-width: 140px;
    }

    .agenda-details h4 {
        color: var(--primary-navy);
        margin-bottom: 0.5rem;
    }

    .agenda-details p,
    .agenda-details ul {
        color: var(--text-secondary);
        margin: 0.5rem 0;
    }

    .agenda-details ul {
        list-style: none;
        padding-left: 0;
    }

    .agenda-details li {
        position: relative;
        padding-left: 20px;
        margin-bottom: 0.5rem;
    }

    .agenda-details li:before {
        content: "•";
        position: absolute;
        left: 0;
        color: var(--primary-teal);
    }

    .register-cta {
        text-align: center;
        margin: 3rem 0;
        padding: 2rem;
        background: linear-gradient(135deg, rgba(78, 205, 196, 0.1), rgba(107, 70, 193, 0.05));
        border-radius: 20px;
    }

    .register-cta .btn {
        margin-top: 1rem;
    }

    .highlight-box {
        background: rgba(78, 205, 196, 0.1);
        border-left: 4px solid var(--primary-teal);
        padding: 1.5rem;
        border-radius: 10px;
        margin: 2rem 0;
    }

    .highlight-box h4 {
        color: var(--primary-navy);
        margin-bottom: 1rem;
    }

    .value-highlight {
        background: white;
        border: 2px solid var(--primary-teal);
        border-radius: 15px;
        padding: 1.5rem;
        text-align: center;
        margin: 2rem 0;
    }

    .value-highlight h4 {
        color: var(--primary-teal);
        margin-bottom: 0.5rem;
    }

    .speaker-section {
        background: rgba(107, 70, 193, 0.05);
        border-radius: 15px;
        padding: 2rem;
        margin: 2rem 0;
    }

    .speaker-section h3 {
        color: var(--primary-navy);
        margin-bottom: 1rem;
    }

    .event-description-content p + p strong:first-child {
        display: inline-block;
        margin-top: 0.5rem;
    }

    .event-description-content ul {
        margin-bottom: 1.5rem;
    }

    @media (max-width: 968px) {
        .event-main {
            grid-template-columns: 1fr;
        }

        .event-sidebar {
            position: relative;
            top: 0;
        }

        .agenda-item {
            flex-direction: column;
            gap: 0.5rem;
        }
    }
</style>
{% endblock %}

{% block content %}
<!-- Event Hero -->
<section class="event-hero">
    <div class="container">
        <div class="section-header">
            <span class="event-badge-small">{{ badge | default("UPCOMING EVENT") }}</span>
            <h1 class="section-title">{{ title }}</h1>
            <p class="section-subtitle">{{ date | shortDate }} | {{ eventType }}</p>
        </div>
    </div>
</section>

<!-- Event Content -->
<section class="event-content">
    <div class="container">
        <div class="event-main">
            <!-- Main Content -->
            <div class="event-body">
                <h2>{{ headline }}</h2>

                {% if bannerImage %}
                <div style="margin: 2rem 0;">
                    <img src="{{ bannerImage }}" alt="{{ title }}" style="width: 100%; border-radius: 15px;">
                </div>
                {% endif %}

                <div style="margin-bottom: 2rem;"></div>

                <p class="lead">{{ leadText }}</p>

                <div class="event-description-content" style="margin-top: 1.5rem;">{{ description | markdown | safe }}</div>

                {% if whatToExpect %}
                <div style="margin-top: 2rem;">
                    <h3 style="margin-bottom: 1rem;">What to Expect</h3>
                    <p>{{ whatToExpect }}</p>
                </div>
                {% endif %}

                {% if takeaways %}
                <div class="highlight-box" style="margin-top: 1.5rem;">
                    <h4>You'll Walk Away With</h4>
                    <ul style="list-style: none; padding: 0;">
                        {% for item in takeaways %}
                        <li style="padding-left: 0; margin-bottom: 0.5rem;">&#10003; {{ item }}</li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}

                {% if speakers %}
                <div class="speaker-section">
                    <h3>About the Workshop Leaders</h3>
                    {% for speaker in speakers %}
                    <div style="margin-bottom: 1.5rem;">
                        <p><strong>{{ speaker.name }}</strong> — {{ speaker.org }}</p>
                        <p style="color: var(--text-secondary);">{{ speaker.bio }}</p>
                    </div>
                    {% endfor %}
                </div>
                {% elif speakerName %}
                <div class="speaker-section">
                    <h3>About the Speaker</h3>
                    <p><strong>{{ speakerName }}</strong> {{ speakerBio }}</p>
                </div>
                {% endif %}

                {% if agenda %}
                <div class="agenda-section">
                    <h3>Event Agenda</h3>
                    {% for item in agenda %}
                    <div class="agenda-item">
                        <div class="agenda-time">{{ item.time }}</div>
                        <div class="agenda-details">
                            <h4>{{ item.title }}</h4>
                            {% if item.description %}<p>{{ item.description }}</p>{% endif %}
                            {% if item.bullets %}
                            <ul>
                                {% for bullet in item.bullets %}
                                <li>{{ bullet }}</li>
                                {% endfor %}
                            </ul>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% endif %}

                {% for note in importantNotes %}
                <div class="highlight-box">
                    <h4>{{ note.title }}</h4>
                    <p>{{ note.text }}</p>
                </div>
                {% endfor %}

                <div class="value-highlight">
                    <h4>Important Note</h4>
                    <p>This event is for women and people who identify as women.</p>
                </div>

                <div class="register-cta">
                    <h3>{{ ctaTitle | default("Ready to Join Us?") }}</h3>
                    <p>{{ ctaDescription | default("Join us for a powerful session!") }}</p>
                    <a href="{{ registrationLink }}" target="_blank" class="btn btn-primary btn-glow">CLICK TO REGISTER</a>
                </div>

                <div class="section-divider">
                    <h3 style="margin-bottom: 1.5rem;">Our Community Values</h3>
                    <p style="font-weight: 600; font-size: 1.2rem; color: var(--primary-teal); margin-bottom: 1rem;">
                        Empower. Respect. Lead.
                    </p>
                    <p>
                        We're building a vibrant, in-person community where women support and elevate each other while learning how to harness AI to drive results and career growth. Whether you're a technologist or a professional in any field integrating AI, you're welcome here.
                    </p>
                </div>

                <div style="display: flex; align-items: center; gap: 1rem; margin: 0.5rem 0 1.5rem 0;">
                    <a href="https://www.linkedin.com/company/atlanta-women-in-ai/" target="_blank" style="display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; background: rgba(78, 205, 196, 0.1); border-radius: 50%; color: var(--primary-teal); transition: all 0.3s; text-decoration: none; flex-shrink: 0;" onmouseover="this.style.background='var(--primary-teal)'; this.style.color='white'; this.style.transform='translateY(-2px)';" onmouseout="this.style.background='rgba(78, 205, 196, 0.1)'; this.style.color='var(--primary-teal)'; this.style.transform='translateY(0)';">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                        </svg>
                    </a>
                    <span style="color: var(--text-secondary);">Follow us on <a href="https://www.linkedin.com/company/atlanta-women-in-ai/" target="_blank" style="color: var(--primary-teal); text-decoration: none; font-weight: 500;">LinkedIn</a> for updates</span>
                </div>

                {% if foundingSponsors or meetingSponsor %}
                <div class="highlight-box">
                    <h4>Thanks to Our Sponsors</h4>
                    {% if foundingSponsors %}<p><strong>Founding Sponsors:</strong> {{ foundingSponsors }}</p>{% endif %}
                    {% if meetingSponsor %}<p style="margin-top: 0.5rem;"><strong>Meeting Sponsor:</strong> {{ meetingSponsor }}</p>{% endif %}
                </div>
                {% endif %}
            </div>

            <!-- Sidebar -->
            <div class="event-sidebar">
                <!-- Event Details Card -->
                <div class="event-info-card glassmorphism">
                    <h3 style="margin-bottom: 1.5rem;">Event Logistics</h3>

                    <div class="event-meta-item">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <div>
                            <span class="label">Date</span>
                            <span class="value">{{ date | dateFormat }}</span>
                        </div>
                    </div>

                    <div class="event-meta-item">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <div>
                            <span class="label">Time</span>
                            <span class="value">{{ time }}</span>
                        </div>
                    </div>

                    <div class="event-meta-item">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <div>
                            <span class="label">Location</span>
                            <span class="value">{{ location }}</span>
                            <span class="label">{{ address }}</span>
                        </div>
                    </div>

                    <div class="event-meta-item">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 3h18l-1 9H4L3 3z"></path>
                            <path d="M3 3l1 9v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-9l1-9"></path>
                            <line x1="9" y1="7" x2="9" y2="17"></line>
                            <line x1="15" y1="7" x2="15" y2="17"></line>
                        </svg>
                        <div>
                            <span class="label">Ticket Price</span>
                            <span class="value">{{ ticketPrice }}</span>
                            {% if ticketNote %}<span class="label">{{ ticketNote }}</span>{% endif %}
                        </div>
                    </div>
                </div>

                <!-- Register Card -->
                <div class="event-info-card glassmorphism" style="text-align: center;">
                    <a href="{{ registrationLink }}" target="_blank" class="btn btn-primary btn-glow" style="width: 100%;">Register Now</a>
                </div>

                <!-- Value Card -->
                <div class="value-highlight glassmorphism">
                    <h4>Why Attend?</h4>
                    <p>{{ whyAttend | default("Connect with other women in AI and gain valuable insights!") }}</p>
                </div>

            </div>
        </div>
    </div>
</section>
{% endblock %}
