            { id: 'rl', label: 'Reinforcement Learning', category: 'concept', x: 450, y: 400, description: 'Learning through rewards and penalties' },
            
            // Technologies
            { id: 'python', label: 'Python', category: 'technology', x: 150, y: 150, description: 'The language of AI development' },
            { id: 'tensorflow', label: 'TensorFlow', category: 'technology', x: 750, y: 150, description: 'Google\'s ML framework' },
            { id: 'pytorch', label: 'PyTorch', category: 'technology', x: 150, y: 450, description: 'Facebook\'s deep learning platform' },
            { id: 'aws', label: 'AWS', category: 'technology', x: 750, y: 450, description: 'Cloud infrastructure for AI' },
            { id: 'jupyter', label: 'Jupyter', category: 'technology', x: 350, y: 120, description: 'Interactive computing notebooks' },
            { id: 'docker', label: 'Docker', category: 'technology', x: 550, y: 120, description: 'Container platform for deployment' },
            { id: 'kubernetes', label: 'Kubernetes', category: 'technology', x: 350, y: 480, description: 'Container orchestration' },
            { id: 'spark', label: 'Spark', category: 'technology', x: 550, y: 480, description: 'Big data processing' },
            
            // Industries
            { id: 'healthcare', label: 'Healthcare', category: 'industry', x: 200, y: 50, description: 'AI in medical diagnosis and treatment' },
            { id: 'marketing', label: 'Marketing', category: 'industry', x: 450, y: 30, description: 'Personalization and customer insights' },
            { id: 'finance', label: 'Finance', category: 'industry', x: 700, y: 50, description: 'Risk analysis and algorithmic trading' },
            { id: 'education', label: 'Education', category: 'industry', x: 450, y: 570, description: 'Personalized learning experiences' },
            { id: 'retail', label: 'Retail', category: 'industry', x: 100, y: 80, description: 'Customer analytics and inventory' },
            { id: 'automotive', label: 'Automotive', category: 'industry', x: 800, y: 80, description: 'Autonomous vehicles and safety' },
            { id: 'energy', label: 'Energy', category: 'industry', x: 200, y: 550, description: 'Smart grids and optimization' },
            { id: 'media', label: 'Media', category: 'industry', x: 700, y: 550, description: 'Content recommendation and creation' },
            
            // Roles
            { id: 'engineer', label: 'AI Engineer', category: 'role', x: 100, y: 300, description: 'Building AI systems and infrastructure' },
            { id: 'scientist', label: 'Data Scientist', category: 'role', x: 250, y: 520, description: 'Analyzing data and building models' },
            { id: 'researcher', label: 'ML Researcher', category: 'role', x: 650, y: 520, description: 'Advancing AI through research' },
            { id: 'pm', label: 'Product Manager', category: 'role', x: 800, y: 300, description: 'Leading AI product strategy' },
            { id: 'analyst', label: 'Data Analyst', category: 'role', x: 100, y: 200, description: 'Interpreting data patterns' },
            { id: 'architect', label: 'ML Architect', category: 'role', x: 800, y: 200, description: 'Designing ML systems' },
            { id: 'ethicist', label: 'AI Ethicist', category: 'role', x: 100, y: 400, description: 'Ensuring responsible AI' },
            { id: 'consultant', label: 'AI Consultant', category: 'role', x: 800, y: 400, description: 'Advising on AI strategy' }
        ];
        
        // Define connections with strength - expanded network
        const connections = [
            // Python connections
            { source: 'python', target: 'ml', strength: 'strong' },
            { source: 'python', target: 'ds', strength: 'strong' },
            { source: 'python', target: 'tensorflow', strength: 'medium' },
            { source: 'python', target: 'pytorch', strength: 'medium' },
            { source: 'python', target: 'jupyter', strength: 'strong' },
            
            // Machine Learning connections
            { source: 'ml', target: 'ds', strength: 'strong' },
            { source: 'ml', target: 'nlp', strength: 'strong' },
            { source: 'ml', target: 'cv', strength: 'strong' },
            { source: 'ml', target: 'dl', strength: 'strong' },
            { source: 'ml', target: 'rl', strength: 'medium' },
            
            // Deep Learning connections
            { source: 'dl', target: 'tensorflow', strength: 'strong' },
            { source: 'dl', target: 'pytorch', strength: 'strong' },
            { source: 'dl', target: 'cv', strength: 'strong' },
            { source: 'dl', target: 'nlp', strength: 'strong' },
            
            // Data Science connections
            { source: 'ds', target: 'aws', strength: 'medium' },
            { source: 'ds', target: 'spark', strength: 'strong' },
            { source: 'ds', target: 'jupyter', strength: 'strong' },
            { source: 'ds', target: 'healthcare', strength: 'medium' },
            { source: 'ds', target: 'finance', strength: 'medium' },
            
            // NLP connections
            { source: 'nlp', target: 'marketing', strength: 'strong' },
            { source: 'nlp', target: 'healthcare', strength: 'medium' },
            { source: 'nlp', target: 'media', strength: 'strong' },
            
            // Computer Vision connections
            { source: 'cv', target: 'automotive', strength: 'strong' },
            { source: 'cv', target: 'healthcare', strength: 'strong' },
            { source: 'cv', target: 'retail', strength: 'medium' },
            
            // Reinforcement Learning connections
            { source: 'rl', target: 'automotive', strength: 'strong' },
            { source: 'rl', target: 'energy', strength: 'medium' },
            { source: 'rl', target: 'finance', strength: 'medium' },
            
            // Technology connections
            { source: 'docker', target: 'kubernetes', strength: 'strong' },
            { source: 'docker', target: 'aws', strength: 'medium' },
            { source: 'kubernetes', target: 'aws', strength: 'strong' },
            { source: 'spark', target: 'aws', strength: 'medium' },
            { source: 'jupyter', target: 'docker', strength: 'weak' },
            
            // Role connections
            { source: 'engineer', target: 'python', strength: 'strong' },
            { source: 'engineer', target: 'kubernetes', strength: 'medium' },
            { source: 'engineer', target: 'docker', strength: 'medium' },
            
            { source: 'scientist', target: 'ds', strength: 'strong' },
            { source: 'scientist', target: 'python', strength: 'strong' },
            { source: 'scientist', target: 'spark', strength: 'medium' },
            
            { source: 'researcher', target: 'dl', strength: 'strong' },
            { source: 'researcher', target: 'rl', strength: 'medium' },
            { source: 'researcher', target: 'pytorch', strength: 'medium' },
            
            { source: 'pm', target: 'retail', strength: 'medium' },
            { source: 'pm', target: 'media', strength: 'medium' },
            { source: 'pm', target: 'finance', strength: 'medium' },
            
            { source: 'analyst', target: 'ds', strength: 'strong' },
            { source: 'analyst', target: 'marketing', strength: 'medium' },
            { source: 'analyst', target: 'retail', strength: 'medium' },
            
            { source: 'architect', target: 'ml', strength: 'strong' },
            { source: 'architect', target: 'kubernetes', strength: 'strong' },
            { source: 'architect', target: 'aws', strength: 'strong' },
            
            { source: 'ethicist', target: 'healthcare', strength: 'strong' },
            { source: 'ethicist', target: 'ai', strength: 'medium' },
            { source: 'ethicist', target: 'finance', strength: 'medium' },
            
            { source: 'consultant', target: 'automotive', strength: 'medium' },
            { source: 'consultant', target: 'energy', strength: 'medium' },
            { source: 'consultant', target: 'ai', strength: 'medium' },
            
            // AI central connections
            { source: 'ai', target: 'ml', strength: 'strong' },
            { source: 'ai', target: 'ds', strength: 'strong' },
            { source: 'ai', target: 'dl', strength: 'strong' },
            { source: 'ai', target: 'rl', strength: 'medium' }
        ];
        
        // Create SVG elements
        const linksGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        const nodesGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        
        svg.appendChild(linksGroup);
        svg.appendChild(nodesGroup);
        
        // Draw connections
        connections.forEach(conn => {
            const sourceNode = nodes.find(n => n.id === conn.source);
            const targetNode = nodes.find(n => n.id === conn.target);
            
            if (sourceNode && targetNode) {
                const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                line.setAttribute('class', `network-link ${conn.strength}`);
                line.setAttribute('x1', sourceNode.x);
                line.setAttribute('y1', sourceNode.y);
                line.setAttribute('x2', targetNode.x);
                line.setAttribute('y2', targetNode.y);
                line.setAttribute('data-source', conn.source);
                line.setAttribute('data-target', conn.target);
                linksGroup.appendChild(line);
            }
        });
        
        // Create nodes with pill shape
        nodes.forEach(node => {
            const group = document.createElementNS('http://www.w3.org/2000/svg', 'g');
            group.setAttribute('class', 'network-node-group');
            group.setAttribute('transform', `translate(${node.x}, ${node.y})`);
            group.setAttribute('data-id', node.id);
            
            // Calculate text width for dynamic pill sizing
            const textLength = node.label.length * 8 + 20;
            const pillWidth = Math.max(textLength, 80);
            const pillHeight = 32;
            
            // Create pill shape (rounded rectangle)
            const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
            rect.setAttribute('class', `network-node-pill node-${node.category}`);
            rect.setAttribute('x', -pillWidth / 2);
            rect.setAttribute('y', -pillHeight / 2);
            rect.setAttribute('width', pillWidth);
            rect.setAttribute('height', pillHeight);
            rect.setAttribute('rx', pillHeight / 2);
            rect.setAttribute('ry', pillHeight / 2);
            
            const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
            text.setAttribute('class', `network-node-label ${node.category === 'industry' || node.category === 'role' ? 'dark-text' : ''}`);
            text.setAttribute('x', 0);
            text.setAttribute('y', 0);
            text.setAttribute('dy', '.1em');
            text.textContent = node.label;
            
            group.appendChild(rect);
            group.appendChild(text);
            nodesGroup.appendChild(group);
            
            // Store node data
            node.element = group;
            node.connections = connections.filter(c => c.source === node.id || c.target === node.id);
            
            // Add interactivity
            let isDragging = false;
            let startX, startY;
            
            group.addEventListener('mouseenter', function(e) {
                if (!isDragging) {
                    // Highlight connected nodes and links
                    node.connections.forEach(conn => {
                        const linkElements = linksGroup.querySelectorAll(
                            `[data-source="${conn.source}"][data-target="${conn.target}"], ` +
                            `[data-source="${conn.target}"][data-target="${conn.source}"]`
                        );
                        linkElements.forEach(link => link.classList.add('highlight'));
                        
                        const connectedId = conn.source === node.id ? conn.target : conn.source;
                        const connectedNode = nodes.find(n => n.id === connectedId);
                        if (connectedNode && connectedNode.element) {
                            connectedNode.element.querySelector('.network-node-pill').style.filter = 'drop-shadow(0 4px 8px rgba(0, 0, 0, 0.2))';
                        }
                    });
                }
            });
            
            group.addEventListener('mouseleave', function() {
                // Remove highlights
                linksGroup.querySelectorAll('.highlight').forEach(link => {
                    link.classList.remove('highlight');
                });
                nodes.forEach(n => {
                    if (n.element) {
                        n.element.querySelector('.network-node-pill').style.filter = '';
                    }
                });
            });
            
            // Drag functionality
            group.addEventListener('mousedown', function(e) {
                isDragging = true;
                group.classList.add('dragging');
                startX = e.clientX - node.x;
                startY = e.clientY - node.y;
                e.preventDefault();
            });
            
            document.addEventListener('mousemove', function(e) {
                if (isDragging && group.classList.contains('dragging')) {
                    const rect = svg.getBoundingClientRect();
                    const scale = 900 / rect.width;
                    
                    node.x = (e.clientX - startX) * scale;
                    node.y = (e.clientY - startY) * scale;
                    
                    // Keep nodes within bounds
                    node.x = Math.max(30, Math.min(870, node.x));
                    node.y = Math.max(30, Math.min(570, node.y));
                    
                    group.setAttribute('transform', `translate(${node.x}, ${node.y})`);
                    
                    // Update connected lines
                    node.connections.forEach(conn => {
                        const lines = linksGroup.querySelectorAll(
                            `[data-source="${conn.source}"][data-target="${conn.target}"], ` +
                            `[data-source="${conn.target}"][data-target="${conn.source}"]`
                        );
                        lines.forEach(line => {
                            if (conn.source === node.id) {
                                line.setAttribute('x1', node.x);
                                line.setAttribute('y1', node.y);
                            } else {
                                line.setAttribute('x2', node.x);
                                line.setAttribute('y2', node.y);
                            }
                        });
                    });
                }
            });
            
            document.addEventListener('mouseup', function() {
                if (group.classList.contains('dragging')) {
                    isDragging = false;
                    group.classList.remove('dragging');
                }
            });
        });
        
        // Add subtle floating animation and link pulse
        let time = 0;
        let linkIndex = 0;
        const allLinks = linksGroup.querySelectorAll('.network-link');
        
        // Animate links in sequence
        function animateLinks() {
            // Reset all links
            allLinks.forEach(link => {
                link.style.strokeOpacity = '0.3';
                link.style.stroke = '#cbd5e1';
            });
            
            // Highlight a subset of links in a wave pattern
            const waveSize = 5;
            for (let i = 0; i < waveSize; i++) {
                const idx = (linkIndex + i) % allLinks.length;
                const link = allLinks[idx];
                const opacity = 0.3 + (0.5 * (1 - i / waveSize));
                link.style.strokeOpacity = opacity;
                link.style.stroke = '#14b8a6';
            }
            
            linkIndex = (linkIndex + 1) % allLinks.length;
        }
        
        // Run link animation every 200ms
        setInterval(animateLinks, 200);
        
        // Subtle node floating animation
        function animate() {
            time += 0.01;
            nodes.forEach((node, i) => {
                if (!node.element.classList.contains('dragging')) {
                    const offsetX = Math.sin(time + i) * 2;
                    const offsetY = Math.cos(time + i * 1.5) * 2;
                    node.element.style.transform = `translate(${node.x + offsetX}px, ${node.y + offsetY}px)`;
                }
            });
            requestAnimationFrame(animate);
        }
        animate();
    });
    </script>
    
