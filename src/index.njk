<!DOCTYPE html>
<html lang="en" prefix="og: http://ogp.me/ns#">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Atlanta Women in AI is a community-driven hub for women leading advancements in artificial intelligence, leadership, and empowerment.">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Atlanta Women in AI">
    <meta property="og:description" content="Atlanta Women in AI is a community-driven hub for women leading advancements in artificial intelligence, leadership, and empowerment.">
    <meta property="og:image" content="https://www.atlantawomeninai.com/logo.png">
    <meta property="og:image:alt" content="Atlanta Women in AI logo">
    <meta property="og:image:width" content="1024">
    <meta property="og:image:height" content="1024">
    <meta property="og:url" content="https://www.atlantawomeninai.com/">
    <meta property="og:site_name" content="Atlanta Women in AI">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Atlanta Women in AI">
    <meta name="twitter:description" content="Atlanta Women in AI is a community-driven hub for women leading advancements in artificial intelligence, leadership, and empowerment.">
    <meta name="twitter:image" content="https://www.atlantawomeninai.com/logo.png">
    <title>Atlanta Women in AI</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/logo.png">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <!-- Navigation -->
    {% set isHome = true %}
    {% set activeNav = "Home" %}
    {% include "nav.njk" %}

    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="hero-background">
            <div class="gradient-mesh"></div>
            <canvas id="particleCanvas"></canvas>
        </div>

        <!-- Event Photos Carousel -->
        <div class="hero-carousel">
            <div class="carousel-container">
                <div class="carousel-track" id="heroCarouselTrack">
                    {% for image in hero.carouselImages %}
                    <div class="carousel-slide">
                        <img src="{{ image.src }}" alt="{{ image.alt }}">
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Carousel Controls (outside carousel for proper z-index) -->
        <button class="carousel-btn carousel-btn-prev" id="carouselPrev">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
        </button>
        <button class="carousel-btn carousel-btn-next" id="carouselNext">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </button>
        <div class="carousel-indicators" id="carouselIndicators"></div>

        <div class="hero-content">
            <h1 class="hero-title">
                <span class="title-line">{{ hero.title.line1 }}</span>
                <span class="title-line gradient-text">{{ hero.title.line2 }}</span>
                <span class="title-line">{{ hero.title.line3 }}</span>
            </h1>
            <p class="hero-subtitle">
                {% set subtitleText = hero.subtitle %}
                {% for word in hero.highlights %}
                    {% set subtitleText = subtitleText | replace(word, '<span class="highlight">' + word + '</span>') %}
                {% endfor %}
                {{ subtitleText | safe }}
            </p>
            <div class="hero-cta-group">
                <a href="{{ hero.buttons.primary.url }}" class="btn btn-primary btn-glow">{{ hero.buttons.primary.text }}</a>
                <a href="{{ hero.buttons.secondary.url }}" class="btn btn-secondary">{{ hero.buttons.secondary.text }}</a>
            </div>
        </div>
        <div class="scroll-indicator">
            <div class="mouse">
                <div class="wheel"></div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Who We Are</h2>
                <div class="title-underline"></div>
            </div>
            <div class="about-content">
                <div class="about-text">
                    <p class="lead">
                        Atlanta Women in AI is a vibrant community of entrepreneurs, tech professionals, engineers, consultants, marketers, and more united by a shared vision: to amplify women's voices in artificial intelligence.
                    </p>
                    <div class="mission-box glassmorphism">
                        <h3>Our Mission</h3>
                        <p>To create a supportive ecosystem where women in AI can connect, learn, and lead. We foster professional growth through knowledge sharing, mentorship, and collaborative innovation.</p>
                    </div>
                </div>
                <div class="about-visual">
                    <div id="network-visualization" class="network-container">
                        <svg id="network-svg" width="100%" height="100%" viewBox="0 0 900 600"></svg>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Events Section -->
    <section id="events" class="events">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Events</h2>
                <p class="section-subtitle">Join our community gatherings and workshops</p>
            </div>

            <!-- Main Events Layout -->
            <div class="events-main-layout">
                {% set nextEvent = collections.upcomingEvents[0] %}
                {% if nextEvent %}
                <!-- Left: Current Event Details -->
                <div class="current-event-panel glassmorphism">
                    <span class="event-badge-small">NEXT EVENT</span>
                    <h3>{{ nextEvent.data.title }}</h3>
                    <div class="event-details">
                        <div class="detail-item">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <span>{{ nextEvent.data.location }}</span>
                        </div>
                        <div class="detail-item">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            <span>{{ nextEvent.data.date | dateFormat }}</span>
                        </div>
                        <div class="detail-item">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            <span>{{ nextEvent.data.time }}</span>
                        </div>
                    </div>
                    <p class="event-description">{{ nextEvent.data.shortDescription or nextEvent.data.leadText or (nextEvent.data.description | truncate(150)) }}</p>
                    <a href="{{ nextEvent.url }}" class="btn btn-small" style="margin-top: 1rem;">View Details</a>
                </div>

                <!-- Right: Countdown & Upcoming -->
                <div class="events-sidebar">
                    <!-- Register Card -->
                    <div class="upcoming-events-card glassmorphism">
                        <h4>Register Now</h4>
                        <p style="margin-bottom: 1rem; color: var(--text-secondary);">Tickets are {{ nextEvent.data.ticketPrice }}. {{ nextEvent.data.ticketNote }}</p>
                        <a href="{{ nextEvent.data.registrationLink }}" target="_blank" class="btn btn-primary" style="width: 100%;">Get Tickets</a>
                    </div>
                </div>
                {% else %}
                <!-- No upcoming events -->
                <div class="current-event-panel glassmorphism">
                    <p>No upcoming events scheduled. Check back soon!</p>
                </div>
                {% endif %}
            </div>

            <!-- Meeting Schedule -->
            <div class="meeting-schedule-section" style="margin-top: 3rem;">
                <h3 class="events-section-title">{{ schedule.year }} Meeting Schedule</h3>
                <div class="glassmorphism" style="padding: 2rem; border-radius: 20px; margin-top: 1.5rem;">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
                        {% for month in schedule.months %}
                        {% if month.type == "lunch" %}
                        <div style="display: flex; align-items: center; gap: 1rem; padding: 1rem; background: rgba(78, 205, 196, 0.1); border-radius: 12px; border-left: 4px solid var(--primary-teal);">
                            <div style="text-align: center; min-width: 50px;">
                                <div style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase;">{{ month.month }}</div>
                                <div style="font-size: 1.5rem; font-weight: 700; color: var(--primary-navy);">{{ month.day }}</div>
                            </div>
                            <div>
                                <div style="font-weight: 600; color: var(--primary-navy);">{{ month.dayOfWeek }}{% if month.special %} <span style="background: var(--primary-teal); color: #fff; font-size: 0.6rem; padding: 3px 8px; border-radius: 8px; margin-left: 5px; vertical-align: middle; font-weight: 700; text-shadow: 0 1px 2px rgba(0,0,0,0.3);">SPECIAL DATE</span>{% endif %}</div>
                                <div style="font-size: 0.875rem; color: var(--text-secondary);">{{ month.time }}</div>
                            </div>
                        </div>
                        {% elif month.type == "evening" %}
                        <div style="display: flex; align-items: center; gap: 1rem; padding: 1rem; background: rgba(107, 70, 193, 0.1); border-radius: 12px; border-left: 4px solid var(--primary-purple);">
                            <div style="text-align: center; min-width: 50px;">
                                <div style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase;">{{ month.month }}</div>
                                <div style="font-size: 1.5rem; font-weight: 700; color: var(--primary-navy);">{{ month.day }}</div>
                            </div>
                            <div>
                                <div style="font-weight: 600; color: var(--primary-navy);">{{ month.dayOfWeek }}{% if month.special %} <span style="background: var(--primary-purple); color: #fff; font-size: 0.6rem; padding: 3px 8px; border-radius: 8px; margin-left: 5px; vertical-align: middle; font-weight: 700; text-shadow: 0 1px 2px rgba(0,0,0,0.3);">SPECIAL DATE</span>{% endif %}</div>
                                <div style="font-size: 0.875rem; color: var(--text-secondary);">{{ month.time }}</div>
                            </div>
                        </div>
                        {% else %}
                        <div style="display: flex; align-items: center; gap: 1rem; padding: 1rem; background: rgba(0, 0, 0, 0.03); border-radius: 12px; border-left: 4px solid #ccc;">
                            <div style="text-align: center; min-width: 50px;">
                                <div style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase;">{{ month.month }}</div>
                                <div style="font-size: 1.2rem; font-weight: 600; color: #999;">—</div>
                            </div>
                            <div>
                                <div style="font-weight: 600; color: #999;">{{ month.dayOfWeek }}</div>
                                <div style="font-size: 0.875rem; color: var(--text-secondary);">{{ month.time }}</div>
                            </div>
                        </div>
                        {% endif %}
                        {% endfor %}
                    </div>
                    <p style="text-align: center; margin-top: 1.5rem; color: var(--text-secondary); font-size: 0.875rem;">
                        <span style="display: inline-block; width: 12px; height: 12px; background: var(--primary-teal); border-radius: 3px; margin-right: 5px; vertical-align: middle;"></span> Lunch meetings (Noon - 1:30p)
                        <span style="margin: 0 1rem;">|</span>
                        <span style="display: inline-block; width: 12px; height: 12px; background: var(--primary-purple); border-radius: 3px; margin-right: 5px; vertical-align: middle;"></span> Evening meetings (6:30p - 8p)
                    </p>
                </div>
            </div>

            <!-- Past Events -->
            <div class="past-events-section">
                <h3 class="events-section-title">Past Events</h3>
                <div class="past-events-grid">
                    {% for event in collections.pastEvents %}
                    <div class="event-card glassmorphism">
                        <div class="event-date-tag past">
                            <span class="month">{{ event.data.date | monthAbbr }}</span>
                            <span class="day">{{ event.data.date | dayNum }}</span>
                        </div>
                        <div class="event-card-content">
                            <h4>{{ event.data.title }}</h4>
                            <p>{{ event.data.shortDescription or (event.data.description | truncate(80)) }}</p>
                            <a href="{{ event.url }}" class="event-link">View Details →</a>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>

    <!-- Why Join Section -->
    <section id="why-join" class="why-join">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">{{ whyJoin.sectionTitle }}</h2>
                <p class="section-subtitle">{{ whyJoin.sectionSubtitle }}</p>
            </div>
            <div class="initiatives-grid">
                {% for card in whyJoin.cards %}
                <div class="initiative-card glassmorphism">
                    <div class="card-icon">
                        {% if card.icon == "people" %}
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                        {% elif card.icon == "tools" %}
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                        </svg>
                        {% elif card.icon == "target" %}
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <circle cx="12" cy="12" r="6"></circle>
                            <circle cx="12" cy="12" r="2"></circle>
                        </svg>
                        {% elif card.icon == "bell" %}
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        {% elif card.icon == "compass" %}
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
                        </svg>
                        {% elif card.icon == "lightbulb" %}
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="9" y1="18" x2="15" y2="18"></line>
                            <line x1="10" y1="22" x2="14" y2="22"></line>
                            <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"></path>
                        </svg>
                        {% elif card.icon == "heart" %}
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                        </svg>
                        {% elif card.icon == "star" %}
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                        {% endif %}
                    </div>
                    <h3>{{ card.title }}</h3>
                    <p>{{ card.description }}</p>
                    <ul>
                        {% for bullet in card.bullets %}
                        <li>{{ bullet }}</li>
                        {% endfor %}
                    </ul>
                    <a href="{{ card.buttonLink }}" {% if 'http' in card.buttonLink %}target="_blank"{% endif %} class="btn btn-small">{{ card.buttonText }}</a>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Join Section -->
    <section id="join" class="join-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">{{ readyToJoin.sectionTitle }}</h2>
                <p class="section-subtitle">{{ readyToJoin.sectionSubtitle }}</p>
            </div>
            <div class="join-options">
                {% for card in readyToJoin.cards %}
                <div class="join-card glassmorphism{% if card.featured %} featured{% endif %}">
                    <div class="join-icon">
                        {% if card.icon == "chat" %}
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                        </svg>
                        {% elif card.icon == "calendar" %}
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        {% elif card.icon == "email" %}
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                        {% elif card.icon == "people-plus" %}
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="8.5" cy="7" r="4"></circle>
                            <line x1="20" y1="8" x2="20" y2="14"></line>
                            <line x1="23" y1="11" x2="17" y2="11"></line>
                        </svg>
                        {% elif card.icon == "star" %}
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                        {% elif card.icon == "heart" %}
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                        </svg>
                        {% elif card.icon == "link" %}
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                        </svg>
                        {% endif %}
                    </div>
                    <h3>{{ card.title }}</h3>
                    <p>{{ card.description }}</p>
                    {% if card.type == "newsletter" %}
                    <form class="join-newsletter-form" id="joinNewsletterForm" action="{{ readyToJoin.mailchimp.formAction }}" method="POST" target="join-mailchimp-response">
                        <input type="hidden" name="u" value="{{ readyToJoin.mailchimp.userId }}">
                        <input type="hidden" name="id" value="{{ readyToJoin.mailchimp.listId }}">
                        <div class="join-form-row">
                            <input type="text" name="FNAME" placeholder="First Name" required class="join-form-input">
                            <input type="text" name="LNAME" placeholder="Last Name" required class="join-form-input">
                        </div>
                        <input type="email" name="EMAIL" placeholder="Email Address" required class="join-form-input">
                        <button type="submit" class="btn btn-primary join-form-submit">{{ card.buttonText }}</button>
                        <div style="position: absolute; left: -5000px;" aria-hidden="true">
                            <input type="text" name="b_{{ readyToJoin.mailchimp.userId }}_{{ readyToJoin.mailchimp.listId }}" tabindex="-1" value="">
                        </div>
                    </form>
                    <span class="join-form-message" id="joinFormMessage"></span>
                    <iframe name="join-mailchimp-response" style="display:none;"></iframe>
                    {% else %}
                    <a href="{{ card.buttonLink }}" {% if 'http' in card.buttonLink %}target="_blank"{% endif %} class="btn btn-primary{% if card.featured %} btn-glow{% endif %}">{{ card.buttonText }}</a>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Footer -->
    {% include "footer.njk" %}

    <!-- Scripts -->
    <script src="/script.js"></script>
    <script src="/footer-form.js"></script>
    
    <!-- Interactive Network Visualization Script -->
    <script>
    // Network Visualization with Force-Directed Layout
    document.addEventListener('DOMContentLoaded', function() {
        const svg = document.getElementById('network-svg');
        const container = document.getElementById('network-visualization');
        
        if (!svg || !container) return;
        
        // Define nodes with categories and descriptions - expanded network
        const nodes = [
            // Core
            { id: 'ai', label: 'AI', category: 'core', x: 450, y: 300, description: 'Artificial Intelligence - The central hub of innovation' },
            
            // Concepts
            { id: 'ml', label: 'Machine Learning', category: 'concept', x: 280, y: 240, description: 'Algorithms that learn from data' },
            { id: 'ds', label: 'Data Science', category: 'concept', x: 620, y: 240, description: 'Extracting insights from complex data' },
            { id: 'nlp', label: 'NLP', category: 'concept', x: 280, y: 360, description: 'Natural Language Processing' },
